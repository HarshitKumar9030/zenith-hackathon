MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=wastewise
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Razorpay test-mode credentials. Never expose the secret or webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Comma-separated existing account emails trusted as Operations administrators.
ADMIN_EMAILS=

# Google Workspace SMTP. Use an app password, never your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=harshit@articulatex.in
SMTP_PASSWORD=
SMTP_FROM=harshit@articulatex.in
# Trusted public app origin for email links. Use HTTPS outside localhost.
APP_URL=http://localhost:3001
